# --- Agent / model key (choose ONE) ---
# Routes Claude Code + Codex through the Vercel AI Gateway, and enables
# agent-eval's failure classification:
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# Or talk to the providers directly instead of the gateway:
# ANTHROPIC_API_KEY=sk-ant-...     # direct Claude Code
# OPENAI_API_KEY=sk-proj-...       # direct Codex

# --- Sandbox (Vercel) ---
# We run evals in Vercel Sandboxes. For local runs, create a token at
# https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token

# In CI (e.g. GitHub Actions) Vercel provides this automatically instead:
# VERCEL_OIDC_TOKEN=your-oidc-token
