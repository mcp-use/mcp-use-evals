{
  "name": "@mcp-use/sdk-evals",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic-readiness evals: how well coding agents build MCP servers with the mcp-use SDK (MCP-2072)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "eval": "tsx --env-file-if-exists=.env src/run.ts",
    "verify-tasks": "tsx --env-file-if-exists=.env src/verify-tasks.ts",
    "synthesize": "tsx --env-file-if-exists=.env src/synthesis.ts",
    "trends": "tsx src/trends.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.48",
    "@ai-sdk/harness-claude-code": "1.0.49",
    "@ai-sdk/harness-codex": "1.0.50",
    "@ai-sdk/openai": "4.0.24",
    "@ai-sdk/provider-utils": "5.0.15",
    "@ai-sdk/sandbox-vercel": "1.0.48",
    "@anthropic-ai/sdk": ">=0.88.0 <1.0.0",
    "@langchain/core": "^1.1.0",
    "ai": "7.0.42",
    "langchain": "^1.2.10",
    "mcp-use": "^1.32.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@emulators/clerk": "0.6.0",
    "@emulators/core": "0.6.0",
    "@emulators/okta": "0.6.0",
    "@types/node": "^25.3.0",
    "jose": "6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/harness>ai": "7.0.42"
    }
  }
}
